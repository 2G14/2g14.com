{
  "name": "2g14.com",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "jscpd": "jscpd",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hono": "^4.13.13",
    "honox": "^0.1.62"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "daisyui": "^5.7.47",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=26.11.1",
    "npm": ">=11.16.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "lefthook": true,
    "workerd": true
  }
}
