{
  "name": "2g14.com",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "jscpd": "jscpd",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "hono": "^4.13.13",
    "honox": "^0.1.56"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "daisyui": "^5.7.47",
    "jscpd": "^5.0.12",
    "knip": "^6.26.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260625.1": true
  }
}
