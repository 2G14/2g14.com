{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "mise": {
    "managerFilePatterns": ["/(^|/)mise-config\\.toml$/"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["engines"],
      "rangeStrategy": "replace"
    }
  ]
}
